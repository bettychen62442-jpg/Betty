# Optional. Without DATABASE_URL, the app uses dev.db in the project root.
# For Docker, compose.yaml sets an absolute path on the persistent data volume.
# DATABASE_URL=file:/absolute/path/to/interview-coach.db
AI_PROVIDER=mock
STORAGE_PROVIDER=local
# Optional in development; required when running the production server.
APP_USERNAME=coach
APP_PASSWORD=

# Free cloud deployment: DATABASE_PROVIDER=postgresql and STORAGE_PROVIDER=supabase.
# DATABASE_URL: Supabase Connect > Session pooler (port 5432), including your DB password.
# DIRECT_URL: optional separate migration connection; otherwise DATABASE_URL is used.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=your-server-only-secret-key
# SUPABASE_STORAGE_BUCKET=interview-coach
